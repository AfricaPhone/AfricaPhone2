rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRecord() {
      return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)) : null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (userRecord() != null && userRecord().data.isAdmin == true)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function matchesOwner(data) {
      return data.userId is string && isOwner(data.userId);
    }

    function isPublicWinner(data) {
      return data != null && data.isWinner == true;
    }

    function isContestCandidateFormSubmission(candidateId) {
      return request.auth == null &&
        resource == null &&
        request.resource != null &&
        request.resource.data.source == 'form' &&
        !(request.resource.data.phoneNormalized is string) &&
        !(request.resource.data.phone is string) &&
        !(request.resource.data.email is string) &&
        !(request.resource.data.emailNormalized is string) &&
        request.resource.data.phoneHash is string &&
        request.resource.data.phoneHash.matches('^[a-f0-9]{32,64}$') &&
        request.resource.data.photoPath is string &&
        request.resource.data.photoPath.matches('^contest-submissions/[a-z0-9-]+/[a-f0-9]{16}(?:-[a-z0-9]{1,12})?\\.(jpg|jpeg|png|webp)$') &&
        request.resource.data.photoUrl is string &&
        request.resource.data.photoUrl.matches('^https://firebasestorage.googleapis.com/.*') &&
        request.resource.data.status == 'published' &&
        request.resource.data.voteCount == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.publishedAt == request.time &&
        request.resource.data.slug is string &&
        candidateId.matches('^[a-z0-9-]{8,64}$');
    }

    // === SECURITY FIX: Empêche l'escalade de privilèges ===
    // Vérifie si l'utilisateur tente de définir le champ isAdmin (création)
    function isSettingAdminField() {
      return request.resource.data.keys().hasAny(['isAdmin']);
    }

    // Vérifie si le champ isAdmin est modifié (mise à jour)
    function isModifyingAdminField() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']);
    }

    function isCustomerDocumentType(type) {
      return type in [
        'profile_photo',
        'identity_card',
        'signed_contract',
        'representative_identity_card'
      ];
    }

    function isCustomerDocumentCreate() {
      return matchesOwner(request.resource.data) &&
        isCustomerDocumentType(request.resource.data.type) &&
        request.resource.data.status == 'under_review' &&
        request.resource.data.storagePath is string &&
        request.resource.data.fileName is string &&
        request.resource.data.contentType is string &&
        request.resource.data.size is number &&
        request.resource.data.size > 0 &&
        request.resource.data.size < 10 * 1024 * 1024 &&
        request.resource.data.createdAt == request.time;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /promoCards/{cardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /winnerGallery/{winnerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /promoCodes/{codeId} {
      allow read, write: if isAdmin();
    }

    // Règles promo (validation) pour les codes
    match /promoRules/{ruleId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Versements promo (dashboard partenaire)
    match /promoPayouts/{payoutId} {
      allow read, write: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /predictions/{predictionId} {
      allow read: if isAdmin() || matchesOwner(resource.data) || isPublicWinner(resource.data);
      allow create: if isAdmin() || matchesOwner(request.resource.data);
      allow update, delete: if isAdmin() || matchesOwner(resource.data);
    }

    match /contests/{contestId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /candidates/{candidateId} {
        allow read: if true;
        allow create: if isAdmin() || isContestCandidateFormSubmission(candidateId);
        allow update, delete: if isAdmin();
      }

      match /votes/{voteId} {
        allow read, write: if isAdmin();
      }
    }

    // === SECURITY FIX: Règles utilisateurs sécurisées ===
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      // Seuls les admins peuvent créer un utilisateur avec isAdmin
      allow create: if isAdmin() || (isOwner(userId) && !isSettingAdminField());
      // Seuls les admins peuvent modifier le champ isAdmin
      allow update: if isAdmin() || (isOwner(userId) && !isModifyingAdminField());
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /customerDocuments/{documentId} {
      allow read: if isAdmin() || matchesOwner(resource.data);
      allow create: if isAdmin() || isCustomerDocumentCreate();
      allow update, delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /voteIntents/{documentId} {
      allow read, write: if isAdmin();
    }

    match /payments/{documentId} {
      allow read, write: if isAdmin();
    }

    match /contestSubmissions/{docId} {
      allow read: if docId == 'settings';
      allow write: if isAdmin();
    }

    match /contestCandidateProfiles/{candidateId} {
      allow read, write: if isAdmin();
    }

    match /contestCandidateLocks/{lockId} {
      allow read, write: if isAdmin();
    }

    match /contestCandidateEmailLocks/{lockId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
