# Copiez ce fichier en .env.local puis complétez les valeurs ci-dessous.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=africaphone-vente.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=africaphone-vente
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=africaphone-vente.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Option 1 : encoder les credentials Admin complets en JSON ou Base64
FIREBASE_ADMIN_CREDENTIALS=

# Option 2 : variables séparées (laisser FIREBASE_ADMIN_CREDENTIALS vide)
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY_BASE64=
FIREBASE_ADMIN_PROJECT_ID=africaphone-vente
FIREBASE_ADMIN_STORAGE_BUCKET=africaphone-vente.firebasestorage.app

# Décommentez pour forcer l'utilisation des réglages par défaut en local (aucun accès Firestore requis)
# CONTEST_FORM_USE_STATIC_SETTINGS=true
