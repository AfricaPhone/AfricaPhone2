{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild-fix-turbopack.js",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "deploy:web": "npm --prefix .. run deploy:web",
    "deploy:form": "firebase deploy --only hosting:contest-form",
    "lint:staged": "npx lint-staged",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@algolia/client-search": "^5.41.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/roboto-mono": "^5.2.8",
    "@google-cloud/storage": "^7.17.3",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.5.0",
    "kkiapay": "^2.0.23",
    "next": "14.2.33",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.13",
    "javascript-obfuscator": "^5.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "webpack-obfuscator": "^3.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings=0"
    ],
    "*.{json,md,css}": [
      "prettier --check"
    ]
  }
