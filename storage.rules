rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isCustomerDocumentUpload(userId, documentType) {
      return isOwner(userId) &&
        request.resource != null &&
        resource == null &&
        documentType.matches('^(profile_photo|identity_card|signed_contract|representative_identity_card)$') &&
        request.resource.size < 10 * 1024 * 1024 &&
        (
          (documentType == 'profile_photo' && request.resource.contentType.matches('^image/(jpeg|jpg|png|webp)$')) ||
          (documentType != 'profile_photo' && request.resource.contentType.matches('^(image/(jpeg|jpg|png|webp)|application/pdf)$'))
        ) &&
        request.resource.metadata.source == 'web-customer' &&
        request.resource.metadata.userId == userId;
    }

    match /public/{allPaths=**} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    function isContestPhotoUpload(contestId, fileName) {
      return request.auth == null &&
        request.resource != null &&
        resource == null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') &&
        fileName.matches('^[a-f0-9]{16}(?:-[a-z0-9]{1,12})?\\.(jpg|jpeg|png|webp)$') &&
        request.resource.metadata.source == 'contest-form' &&
        request.resource.metadata.contestId == contestId &&
        request.resource.metadata.phoneHash.matches('^[a-f0-9]{32,64}$');
    }

    match /contest-submissions/{contestId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create: if isContestPhotoUpload(contestId, fileName);
      allow update, delete: if false;
    }

    match /customer-documents/{userId}/{documentType}/{fileName} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if false;
      allow create: if isAdmin() || isCustomerDocumentUpload(userId, documentType);
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow get, list, create, update, delete: if isAdmin();
    }
  }
}
